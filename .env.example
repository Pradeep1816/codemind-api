APP_NAME=codemind
APP_HOST=0.0.0.0
APP_PORT=3000
NODE_ENV=development
API_PREFIX=api
API_VERSION=1
WEB_APP_URL=http://localhost:3001
CORS_CREDENTIALS=false
TRUST_PROXY=false

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=codemind
DATABASE_SSL=false

JWT_SECRET=replace_with_a_secret_at_least_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_secret_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=30d
INVITATION_TTL_HOURS=72

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_DEFAULT_LIMIT=120
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_REGISTER_RATE_LIMIT=3
AUTH_LOGIN_RATE_LIMIT=5
AUTH_REFRESH_RATE_LIMIT=20
AUTH_INVITATION_ACCEPT_RATE_LIMIT=5
AUTH_INVITATION_CREATE_RATE_LIMIT=10
REPOSITORY_SYNC_RATE_LIMIT_TTL_MS=60000
REPOSITORY_SYNC_RATE_LIMIT=5

GIT_WORKSPACE_ROOT=.codemind/repositories
GIT_LOCAL_REPOSITORIES_ROOT=
GIT_COMMAND_TIMEOUT_MS=120000
GIT_MAX_OUTPUT_BYTES=1048576
GIT_CLONE_DEPTH=1
# Directory for temporary, service-owned indexing workspaces. Optional.
INDEXING_WORKSPACE_ROOT=.codemind/indexing

# Maximum files one index job may select. Optional safety limit.
INDEXING_MAX_FILES=100000

# Maximum supported size of one file in bytes (2 MiB). Optional safety limit.
INDEXING_MAX_FILE_SIZE_BYTES=2097152

# Maximum total selected repository content in bytes (512 MiB). Optional.
INDEXING_MAX_TOTAL_BYTES=536870912

# Maximum repository-relative path length. Optional safety limit.
INDEXING_MAX_PATH_LENGTH=1024

# Maximum number of nested path components. Optional safety limit.
INDEXING_MAX_PATH_DEPTH=64

# Maximum parser symbols accepted from one file. Optional safety limit.
INDEXING_MAX_SYMBOLS_PER_FILE=10000

# Maximum dependency records accepted from one file. Optional safety limit.
INDEXING_MAX_DEPENDENCIES_PER_FILE=20000

# Worker lease duration in milliseconds; ownership expires without a heartbeat.
INDEXING_JOB_LEASE_MS=60000

# Delay in milliseconds before a retryable failed job can run again.
INDEXING_JOB_RETRY_DELAY_MS=30000

# Maximum automatic processing attempts before a job becomes failed.
INDEXING_JOB_MAX_ATTEMPTS=3

# Maximum expired worker leases recovered in one database pass.
INDEXING_JOB_RECOVERY_BATCH_SIZE=100

# Heartbeat interval in milliseconds; must be less than the lease duration.
INDEXING_JOB_HEARTBEAT_INTERVAL_MS=15000

# Required for this process to consume jobs; use false for an API-only process.
INDEXING_WORKER_ENABLED=true

# Optional stable worker name; blank automatically uses hostname and process ID.
INDEXING_WORKER_ID=

# Delay in milliseconds between queue polls when no job is available.
INDEXING_WORKER_POLL_INTERVAL_MS=2000

# Interval in milliseconds between expired-lease recovery scans.
INDEXING_WORKER_RECOVERY_INTERVAL_MS=30000

# Maximum source bytes read during one analysis snapshot (512 MiB).
ANALYSIS_MAX_TOTAL_SOURCE_BYTES=536870912

# Maximum normalized facts emitted by analyzers for one file.
ANALYSIS_MAX_FACTS_PER_FILE=20000

# Maximum analyzer diagnostics emitted for one file.
ANALYSIS_MAX_DIAGNOSTICS_PER_FILE=1000

# Maximum TypeScript compiler AST nodes visited for one file.
ANALYSIS_MAX_AST_NODES_PER_FILE=200000

# Maximum serialized property payload for one fact (16 KiB).
ANALYSIS_MAX_PROPERTY_BYTES=16384

# Maximum Phase 3 symbols retained for one architecture-resolution pass.
ANALYSIS_MAX_ARCHITECTURE_SYMBOLS=250000

# Maximum files retained for one architecture-resolution pass.
ANALYSIS_MAX_ARCHITECTURE_FILES=100000

# Maximum Phase 3 dependencies retained for one architecture-resolution pass.
ANALYSIS_MAX_ARCHITECTURE_DEPENDENCIES=500000

# Maximum derived facts and diagnostics emitted by one architecture pass.
ANALYSIS_MAX_ARCHITECTURE_OUTPUTS=500000

# Maximum HTTP-route workflows derived from one repository snapshot.
ANALYSIS_MAX_WORKFLOWS=10000

# Maximum workflow-step facts derived across one repository snapshot.
ANALYSIS_MAX_WORKFLOW_STEPS=100000

# Maximum direct ordered steps retained for one route workflow.
ANALYSIS_MAX_WORKFLOW_STEPS_PER_WORKFLOW=1000

# Version recorded on knowledge builds and snapshots for reproducibility.
KNOWLEDGE_ANALYZER_BUNDLE_VERSION=phase4-v1

# Maximum nodes or edges persisted in one knowledge transaction.
KNOWLEDGE_PERSISTENCE_BATCH_SIZE=500

# Knowledge worker lease duration in milliseconds.
KNOWLEDGE_JOB_LEASE_MS=60000

# Delay before an automatically retried knowledge build becomes claimable.
KNOWLEDGE_JOB_RETRY_DELAY_MS=30000

# Maximum automatic attempts for one knowledge build.
KNOWLEDGE_JOB_MAX_ATTEMPTS=3

# Maximum expired knowledge leases recovered in one pass.
KNOWLEDGE_JOB_RECOVERY_BATCH_SIZE=100

# Heartbeat interval; must be shorter than the knowledge lease duration.
KNOWLEDGE_JOB_HEARTBEAT_INTERVAL_MS=15000

# Required for this process to consume knowledge builds.
KNOWLEDGE_WORKER_ENABLED=true

# Optional worker name; blank uses hostname and process ID.
KNOWLEDGE_WORKER_ID=

# Delay between knowledge queue polls when no build is available.
KNOWLEDGE_WORKER_POLL_INTERVAL_MS=2000

# Interval between expired knowledge-lease recovery scans.
KNOWLEDGE_WORKER_RECOVERY_INTERVAL_MS=30000

AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
