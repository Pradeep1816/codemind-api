# E2E tests load the normal .env for PostgreSQL credentials and then connect
# to this isolated database. The database name must end with `_test`.
E2E_DATABASE_NAME=codemind_test

# Add DATABASE_HOST, DATABASE_PORT, DATABASE_USER, DATABASE_PASSWORD, or
# DATABASE_SSL here only when the test database uses different connection
# settings. Copy this file to .env.test.local before changing values.
